// La guida all'installazione. Se Claude, Obsidian e il vault ci sono già, non si apre: Delion è pronto e non chiede niente.
// Se manca qualcosa, la mostra con il pulsante per installarla (winget) o il link dove attivarla; ogni passo si può saltare.
import { $, el, api, notifica, STATO } from './base.js'
import { fermaCartella, boxCartella } from './cartella.js'

const PIANI = { // claude.com/it/pricing e /it/pricing/team, visti il 19-11-2026
  individuale: { url: 'https://claude.com/it/pricing', testo: 'Claude Pro: 15 € al mese con l\'annuale, 18 € con il mensile; Max 90 € o Ultra 180 € al mese per lavorarci tutto il giorno. IVA esclusa.' },
  azienda: { url: 'https://claude.com/it/pricing/team', testo: 'Claude Team, da 2 a 150 persone: 20 $ a persona al mese con l\'annuale, 25 $ con il mensile. Oltre 20 persone Enterprise: 20 $ a postazione, minimo 20, più l\'uso a tariffe API. IVA esclusa.' },
}
const web = url => api('/api/apri', { app: 'web', nota: url }).catch(e => notifica(e.message, { tipo: 'sempre' }))
let s = null, timer = null

export async function guida (forza) {
  s = await api('/api/installazione').catch(() => null)
  if (!s) return false
  const c = s.controlli, pronto = c.claude.presente !== false && c.obsidian.presente !== false && c.vault.presente
  if (!forza && (s.finita || pronto)) return false // tutto pronto, o saltata: niente guida
  disegna()
  return true
}

function chiudi () { $('[data-guida]').hidden = true; clearInterval(timer) }

function riga (ok, titolo, spiega, ...azioni) {
  return el('li', { class: 'passo' + (ok ? ' ok' : '') }, el('span', { class: 'segno', 'aria-hidden': 'true', testo: ok ? '✓' : '' }),
    el('div', {}, el('b', { testo: titolo }), el('small', { testo: spiega })), el('div', { class: 'bottoni' }, ...(ok ? [el('span', { class: 'sopra', testo: 'c\'è' })] : azioni)))
}

function programma (k, titolo, spiega) {
  const c = s.controlli[k], ok = c.presente === true || s.segnati?.['ho-' + k]
  const stato = typeof c.inCorso === 'string' && c.inCorso !== 'finita' && c.inCorso !== 'in corso' ? c.inCorso : ''
  return riga(ok, titolo, stato || spiega,
    c.inCorso === 'in corso' ? el('span', { class: 'sopra', testo: 'Lo sto installando… se Windows chiede il permesso, rispondi «Sì»' })
      : el('button', { type: 'button', class: 'primario', testo: 'Installa', title: 'Mirion lo installa con winget: Windows ti chiede il permesso', onclick: async () => {
        try { const r = await api('/api/installazione/installa', { programma: k }); if (r.via === 'sito') { web(r.sito); notifica((r.perche ? r.perche[0].toUpperCase() + r.perche.slice(1) + ': ' : '') + 'installalo dalla pagina che si è aperta.', { tipo: 'sempre' }) } s = await api('/api/installazione'); disegna(); controlla() } catch (e) { notifica(e.message, { tipo: 'sempre' }) } } }),
    c.inCorso !== 'in corso' && el('button', { type: 'button', class: 'quieto', testo: 'Dal sito', title: 'Si apre la pagina ufficiale: l\'installazione la fai tu, lì', onclick: () => { web(c.sito); controlla() } }),
    c.presente === null && el('button', { type: 'button', class: 'quieto', testo: 'Ce l\'ho già', onclick: async () => { s = { ...s, ...(await api('/api/installazione/segna', { passo: 'ho-' + k, fatto: true })) }; disegna() } }))
}

async function controlla () {
  clearInterval(timer)
  timer = setInterval(async () => { s = await api('/api/installazione'); disegna(); if (!Object.values(s.controlli).some(c => c.inCorso === 'in corso')) clearInterval(timer) }, 3000)
}

function disegna () {
  const g = $('[data-guida]'), c = s.controlli, profilo = s.profilo ?? 'individuale', piano = PIANI[profilo]
  const cartella = el('input', { placeholder: 'C:\\Users\\tu\\Documents\\Cervello', 'aria-label': 'Cartella del vault', value: c.vault.cartella || null })
  // la cartella scritta si controlla prima di usarla (cartella.js): un problema lo dice, una cartella nuova chiede «la creo?»
  const esitoCartella = boxCartella()
  const usaCartella = async crea => {
    try {
      const r = await api('/api/installazione/vault', { cartella: cartella.value, crea })
      if (fermaCartella(r, { box: esitoCartella, campo: cartella, riprova: usaCartella })) return
      Object.assign(STATO, await api('/api/stato')); s = await api('/api/installazione'); disegna()
    } catch (err) { notifica(err.message, { tipo: 'sempre' }) }
  }
  g.hidden = false
  g.replaceChildren(el('div', { class: 'guida-scatola' },
    el('div', { class: 'guida-testa' }, el('img', { src: '/marchio.svg', alt: '', width: 40, height: 40 }), el('div', {}, el('h2', { testo: 'Prepariamo Mirion' }), el('p', { class: 'sopra', testo: 'Mirion lavora con Claude e con il tuo vault di Obsidian. Qui vedi cosa c\'è già sul computer e cosa manca.' }))),
    el('div', { class: 'scelta', role: 'radiogroup', 'aria-label': 'Per chi è' }, ...[['individuale', 'Per me'], ['azienda', 'Per un\'azienda (più di due persone)']].map(([k, t]) =>
      el('button', { type: 'button', role: 'radio', 'aria-checked': String(k === profilo), testo: t, onclick: async () => { s = { ...s, ...(await api('/api/installazione/profilo', { profilo: k })) }; disegna() } }))),
    el('ol', { class: 'passi' },
      // l'account di Claude: per cominciare basta quello gratuito (Marco, 23-11); i piani a pagamento per lavorarci tutto il giorno
      riga(s.segnati?.piano, 'Un account di Claude', 'Per cominciare basta l’account gratuito: lo crei con la tua email. ' + piano.testo, el('button', { type: 'button', class: 'primario', testo: 'Account gratuito', onclick: () => web('https://claude.ai/login') }), el('button', { type: 'button', class: 'secondario', testo: 'I piani a pagamento', onclick: () => web(piano.url) }), el('button', { type: 'button', class: 'quieto', testo: 'Ce l\'ho', onclick: async () => { s = { ...s, ...(await api('/api/installazione/segna', { passo: 'piano', fatto: true })) }; disegna() } })),
      programma('claude', 'Claude per il desktop', 'È Claude che lavora dentro il tuo cervello: va bene anche con l’account gratuito.'),
      programma('obsidian', 'Obsidian', 'Dove vivono le note. Mirion le legge e le mostra.'),
      profilo === 'azienda' && programma('git', 'Git', 'Per condividere il vault con le altre persone dell\'azienda.'),
      profilo === 'azienda' && riga(s.segnati?.github, 'Un repository GitHub privato per il vault condiviso', 'Uno per l\'azienda; ognuno lo clona sul suo computer.', el('button', { type: 'button', class: 'secondario', testo: 'Crea il repository', onclick: () => web('https://github.com/new') }), el('button', { type: 'button', class: 'quieto', testo: 'Fatto', onclick: async () => { s = { ...s, ...(await api('/api/installazione/segna', { passo: 'github', fatto: true })) }; disegna() } })),
      riga(c.vault.presente, 'La cartella del vault', c.vault.presente ? c.vault.cartella : 'Scrivi la cartella del tuo vault: Mirion controlla che sia giusta e, se non c’è ancora, ti chiede se crearla.',
        el('form', { class: 'riga-form', onsubmit: async e => { e.preventDefault(); usaCartella(false) } }, cartella, el('button', { class: 'secondario', testo: 'Usa questa' })), esitoCartella)),
    el('div', { class: 'bottoni guida-piede' },
      el('button', { type: 'button', class: 'primario', testo: 'Comincia', onclick: async () => { await api('/api/installazione/fine', { si: true }); chiudi(); location.reload() } }),
      el('button', { type: 'button', class: 'quieto', testo: 'Salta per ora', onclick: async () => { await api('/api/installazione/fine', { si: true }); chiudi() } }))))
}
