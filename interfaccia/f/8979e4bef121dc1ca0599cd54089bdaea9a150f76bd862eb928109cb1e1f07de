/* La stanza Flussi (app/js/flussi.js e flussi-mappa.js, 27-11). Marco: «trattale come delle card, tutta la pagina deve essere
   compatibile»: i fondi, i bordi, il vetro e le tinte li danno le classi della scrivania (.fascia in scrivania.css e aurora.css,
   .sezione-riquadri in su-misura.css). Qui solo come stanno in pagina, e gli stati. */
#flussi .per-persona { flex-wrap: wrap; }
.flussi-scelta { margin-top: .9rem; }
.flussi-cima { margin-top: 1rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem; align-items: start; }
.flussi-sezione { margin-top: 1.2rem; padding-bottom: 1rem; }

/* gli stati: un pallino e la parola, nel colore dello stato */
.flusso-stato { --c: var(--tenue); display: inline-flex; align-items: center; gap: .35rem; font-size: .72rem; font-weight: 600; white-space: nowrap; color: var(--c);
  background: color-mix(in srgb, var(--c) 14%, transparent); border: 1px solid color-mix(in srgb, var(--c) 30%, transparent); border-radius: 999px; padding: 2px 9px 2px 7px; }
.flusso-stato i { width: 7px; height: 7px; border-radius: 50%; background: var(--c); }
.flusso-stato.ok, .flusso-stato.fatto { --c: var(--bene); }
.flusso-stato.attenzione { --c: var(--presto); }
.flusso-stato.rotto, .flusso-stato.fermo { --c: var(--scaduto); }
.flusso-stato.in-corso { --c: var(--lilla); }
.flusso-stato.daconfermare i { background: transparent; border: 1.5px dashed var(--c); }

/* i piani */
.flusso-testa h2 { font-size: clamp(1.1rem, 2.4vw, 1.5rem); line-height: 1.25; margin-top: .2rem; }
.flusso-richiesta { margin: .6rem 0 0; color: var(--testo-2); font-size: .9rem; border-left: 3px solid var(--viola); padding-left: .75rem; }
.flusso-errore { margin: .6rem 0 0; color: var(--scaduto); font-size: .9rem; }
.flusso-barra { margin-top: 1rem; display: flex; align-items: center; gap: .75rem; font-size: .85rem; color: var(--tenue); }
.flusso-pista { flex: 1; height: 8px; border-radius: 99px; background: color-mix(in srgb, var(--testo) 8%, transparent); overflow: hidden; display: flex; }
.flusso-pista span.fatto { background: var(--bene); } .flusso-pista span.in-corso { background: var(--viola); } .flusso-pista span.fermo { background: var(--scaduto); }
.flusso-adesso { border-color: color-mix(in srgb, var(--viola) 55%, transparent) !important; }
.flusso-adesso b { display: block; font-family: var(--titoli); margin-top: .2rem; }
.flusso-passi { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: .8rem; }
.flusso-passo { display: flex; flex-direction: column; gap: .45rem; margin: 0; }
.flusso-passo.in-corso { border-color: color-mix(in srgb, var(--viola) 60%, transparent) !important; box-shadow: 0 0 0 1px color-mix(in srgb, var(--viola) 35%, transparent), 0 14px 40px -18px var(--viola) !important; }
.flusso-passo h3 { font-size: 1rem; line-height: 1.3; }
.flusso-riga { display: flex; justify-content: space-between; align-items: center; gap: .5rem; }
.flusso-esito { margin: 0; color: var(--testo-2); font-size: .86rem; word-break: break-word; }
.flusso-prompt { margin: 0; font-size: .82rem; color: var(--lilla); background: color-mix(in srgb, var(--viola) 10%, transparent); border-radius: 10px; padding: .5rem .65rem; }
.flusso-sotto { list-style: none; margin: 0; padding: 0; display: grid; gap: .25rem; font-size: .84rem; }
.flusso-sotto li { display: flex; gap: .5rem; color: var(--testo-2); } .flusso-sotto li.fatto { color: var(--tenue); text-decoration: line-through; }
.flusso-file, .flusso-piede { display: flex; flex-wrap: wrap; gap: .35rem .8rem; font-size: .78rem; color: var(--testo-2); word-break: break-word; }
.flusso-piede { color: var(--tenue); margin-top: auto; }
.flusso-file span, .flusso-piede span { display: inline-flex; align-items: center; gap: .3rem; }
.flusso-file svg.ic, .flusso-piede svg.ic { width: 13px; height: 13px; }
#flussi a, .mappa-link { color: var(--lilla); }
.flusso-cronologia { list-style: none; margin: 0; display: grid; gap: .4rem; }
.flusso-cronologia li { display: flex; gap: .75rem; font-size: .85rem; color: var(--testo-2); border-bottom: 1px solid var(--linea); padding-bottom: .4rem; word-break: break-word; }
.flusso-cronologia li:last-child { border-bottom: 0; padding-bottom: 0; }
.flusso-cronologia time { color: var(--tenue); min-width: 3.2em; font-variant-numeric: tabular-nums; }

/* la mappa: le corsie sono sezioni, le cose sono card, i fili passano sotto le card */
.mappa-primo { display: flex; flex-direction: column; gap: .25rem; text-align: left; width: 100%; color: var(--testo); font: inherit; cursor: pointer; border-color: color-mix(in srgb, var(--viola) 55%, transparent) !important; }
.mappa-comandi { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; }
.mappa-comandi input[type=search] { flex: 1 1 220px; min-width: 0; }
.mappa-legenda { margin: 0; flex-basis: 100%; display: flex; flex-wrap: wrap; gap: .4rem .8rem; align-items: center; font-size: .8rem; color: var(--tenue); }
.mappa-domande { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: .6rem; }
.mappa-domanda { display: flex; gap: .6rem; align-items: flex-start; text-align: left; color: var(--testo-2); font: inherit; font-size: .86rem; cursor: pointer; margin: 0; }
.mappa-tela { position: relative; margin-top: 1.2rem; }
.mappa-fili { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; z-index: 0; }
.mappa-fili path { fill: none; stroke: color-mix(in srgb, var(--testo) 22%, transparent); stroke-width: 1.2; transition: opacity .15s; }
.mappa-fili path.acceso { stroke: var(--viola); stroke-width: 2.2; filter: drop-shadow(0 0 4px color-mix(in srgb, var(--viola) 60%, transparent)); }
.mappa-fili path.spento { opacity: .06; }
.mappa-fili text { font-size: 11px; fill: var(--lilla); paint-order: stroke; stroke: var(--fondo); stroke-width: 4px; }
.mappa-corsie { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.2rem; align-items: start; }
.mappa-corsie > .sezione-riquadri { grid-column: auto; grid-row-end: auto; margin-top: 0; }
.mappa-nodi { display: grid; gap: .6rem; }
.mappa-nodo { display: flex; flex-direction: column; gap: .3rem; text-align: left; color: var(--testo); font: inherit; cursor: pointer; margin: 0; transition: opacity .15s, border-color .15s, transform .15s; }
.mappa-nodo b { font-family: var(--titoli); font-size: .95rem; }
.mappa-breve { color: var(--tenue); font-size: .8rem; }
.mappa-nodo:hover { transform: translateY(-1px); }
.mappa-nodo.daconfermare { border-style: dashed !important; }
.mappa-nodo.scelto { border-color: var(--tinta, var(--viola)) !important; box-shadow: 0 0 0 1px var(--tinta, var(--viola)), 0 14px 40px -18px var(--tinta, var(--viola)) !important; }
.mappa-nodo.lontano { opacity: .3; }
.mappa-scheda { position: relative; margin: calc(-.6rem - 1px) 0 0; padding: .2rem 1.25rem .9rem !important; border-radius: 0 0 16px 16px !important; transform-origin: top center;
  background: color-mix(in srgb, var(--tinta, var(--viola)) 5%, transparent) !important; backdrop-filter: blur(12px);
  border: 1px solid var(--tinta, var(--viola)) !important; border-top: 0 !important; box-shadow: 0 0 0 1px var(--tinta, var(--viola)), 0 18px 40px -22px var(--tinta, var(--viola)) !important; clip-path: inset(0 -60px -60px -60px); }
/* la card aperta e la tendina sono una cosa sola (Marco, 28-11: «come se fosse un'estensione della card aperta, trasparente»): sotto la card niente bordo né angoli, una linea leggera fa da piega */
.mappa-nodo.scelto:has(+ .mappa-scheda:not([hidden])) { border-bottom-left-radius: 0 !important; border-bottom-right-radius: 0 !important; border-bottom-color: transparent !important; clip-path: inset(-60px -60px 0 -60px); }
.mappa-scheda::before { content: ''; position: absolute; left: 1.25rem; right: 1.25rem; top: 0; height: 1px; background: color-mix(in srgb, var(--tinta, var(--viola)) 30%, transparent); }
.mappa-scheda > dl:first-of-type { padding-top: .7rem; }
/* la tendina che scende dalla card toccata (28-11-2026): piccola, due cose; «Apri tutto» per il resto */
.mappa-scheda.scende { animation: mappa-scende .4s cubic-bezier(.2, .8, .2, 1) both; }
@keyframes mappa-scende { from { opacity: 0; clip-path: inset(0 0 100% 0); } to { opacity: 1; clip-path: inset(0 0 0 0); } }
.mappa-chiudi { position: absolute; right: .7rem; top: .55rem; display: grid; place-items: center; width: 26px; height: 26px; border-radius: 8px; border: 0; background: transparent; color: var(--tenue); cursor: pointer; }
.mappa-chiudi:hover { color: var(--testo); background: color-mix(in srgb, var(--testo) 8%, transparent); }
.mappa-scheda dl { margin: 0; display: grid; gap: .3rem; }
.mappa-scheda dt { font-size: .66rem; text-transform: uppercase; letter-spacing: .07em; color: var(--tenue); }
.mappa-scheda dd { margin: 0 0 .25rem; color: var(--testo-2); font-size: .86rem; line-height: 1.4; word-break: break-word; }
.mappa-due { padding-right: 1.6rem; }
.mappa-resto { margin-top: .4rem !important; padding-top: .5rem; border-top: 1px solid color-mix(in srgb, var(--testo) 8%, transparent); animation: mappa-scende .35s cubic-bezier(.2, .8, .2, 1) both; }
.mappa-scheda ul { margin: 0; padding-left: 1.1rem; }
.mappa-scheda code { font-size: .78rem; background: color-mix(in srgb, var(--testo) 8%, transparent); padding: 1px 6px; border-radius: 6px; }
.mappa-apri { display: inline-flex; align-items: center; gap: .3rem; margin-top: .15rem; padding: .2rem .55rem; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--tinta, var(--viola)) 35%, transparent);
  background: transparent; color: var(--testo-2); font: inherit; font-size: .76rem; cursor: pointer; transition: background .25s, color .25s; }
.mappa-apri:hover { color: var(--testo); background: color-mix(in srgb, var(--tinta, var(--viola)) 14%, transparent); }
.mappa-link { background: none; border: 0; padding: 0; text-decoration: underline; cursor: pointer; font: inherit; }
@media (max-width: 700px) {
  .flusso-passi { grid-template-columns: 1fr; }
}
@media (prefers-reduced-motion: reduce) { .mappa-scheda.scende, .mappa-resto { animation: none; } .mappa-nodo, .mappa-fili path { transition: none; } .mappa-nodo:hover { transform: none; } }
