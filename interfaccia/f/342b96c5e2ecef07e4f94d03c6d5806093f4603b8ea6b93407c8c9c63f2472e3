// subito dentro Mirion Fit (27-11-2026, Marco: «quando passo al fit da trainer vallo istantaneamente, non c'è bisogno della schermata
// di mezzo»): l'invito porta alla pagina del QR (…/fit/?k=…&a=…), che mostra «Apri Mirion Fit»; qui si salta e si va dritti alla web
// app (…/fit/app/?k=…&a=…&tr=…#/diario), come farebbe quel bottone. Un link che non è della pagina del QR resta com'è
function direttoInFit (u) {
  if (!/\/fit\/?$/.test(u.pathname)) return u
  // senza il codice «a» si va dentro lo stesso: la web app apre il lucchetto con l'invito ancora valido (fit-online.js invitoValido)
  const a = (/[#&]a=([\w.~-]+)/.exec(u.hash) || [])[1] || u.searchParams.get('a')
  if (!u.searchParams.get('k') && !a) return u
  const d = new URL(u.pathname.replace(/\/?$/, '/') + 'app/', u.origin)
  for (const k of ['k', 'tr']) if (u.searchParams.get(k)) d.searchParams.set(k, u.searchParams.get(k))
  if (a) d.searchParams.set('a', a); d.hash = '#/diario'
  // nello stesso ordine del bottone della pagina: k, a, tr
  const q = new URLSearchParams(); for (const k of ['k', 'a', 'tr']) if (d.searchParams.get(k)) q.set(k, d.searchParams.get(k))
  d.search = q.toString()
  return d
}
