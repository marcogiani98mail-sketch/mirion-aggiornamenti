// Ctrl+K: un campo solo per andare ovunque. Le stanze, i tuoi accessi, le note del vault,
// e «Chiedi a Claude»: la frase scritta va a Claude, aperto sul tuo vault.
import { $, el, api, STATO, nomeNota, notifica } from './base.js'
import { conIA, inOrdine } from './ia.js'
import { apriAccesso, icona } from './dock.js'

const STANZE = [['scrivania', 'Scrivania'], ['scadute', 'Task'], ['lavoro', 'Lavoro e accessi'], ['lavagne', 'Lavagne'], ['calendario', 'Calendario'], ['scrivania?sezione=squadra', 'Squadra'], ['cerca', 'Cerca nelle note'], ['diario', 'Diario'], ['ia', 'Lavoro con l’IA'], ['impostazioni', 'Impostazioni']]
let scelta = 0, voci = [], timer = null

function chiudi () { $('[data-comandi]').hidden = true }
export function apriComandi (testo = '') {
  const c = $('[data-comandi]'); c.hidden = false
  const campo = $('.comandi-campo', c); campo.value = testo; campo.focus(); aggiorna()
}

async function aggiorna () {
  const q = $('.comandi-campo').value.trim(), qq = q.toLowerCase()
  const trova = s => !qq || s.toLowerCase().includes(qq)
  voci = []
  if (q) for (const ia of inOrdine()) voci.push({ gruppo: 'Chiedi', testo: `Chiedi a ${ia.nome}: «${q}»`, icona: { id: ia.id, nome: ia.nome }, fai: () => conIA.testo(q, ia.id) })
  for (const [id, nome] of STANZE) if (trova(nome)) voci.push({ gruppo: 'Vai a', testo: nome, segno: '→', fai: () => { location.hash = id } })
  // la scelta dell'avvio, di nuovo: il workspace o un prodotto (scelta.js)
  if (STATO.prodotti && trova('Prodotti e workspace')) voci.push({ gruppo: 'Vai a', testo: 'Prodotti e workspace', segno: '→', fai: async () => {
    const d = await api('/api/prodotti').catch(() => null)
    if (d?.prodotti?.length) (await import('./scelta.js')).scelta(d, { dopo: true }); else notifica('Questo cervello non ha prodotti: si aggiungono in .delion/prodotti.json.')
  } })
  for (const a of STATO.preset?.attivo?.accessi ?? []) if (trova(a.nome) || trova(a.gruppo ?? '')) voci.push({ gruppo: 'Apri', testo: a.nome, icona: a, fai: () => apriAccesso(a) })
  disegna()
  clearTimeout(timer)
  if (q.length >= 3) timer = setTimeout(async () => {
    try {
      const note = await api('/api/cerca?q=' + encodeURIComponent(q))
      if ($('.comandi-campo').value.trim() !== q) return
      voci = voci.filter(v => v.gruppo !== 'Note').concat(note.slice(0, 7).map(n => ({ gruppo: 'Note', testo: nomeNota(n.nota), sotto: n.pezzo, segno: '¶', fai: () => { location.hash = 'cerca?n=' + encodeURIComponent(n.nota) } })))
      disegna()
    } catch { }
  }, 220)
}

function disegna () {
  scelta = Math.min(scelta, Math.max(0, voci.length - 1))
  let gruppo = ''
  $('.comandi-voci').replaceChildren(...voci.flatMap((v, i) => {
    const out = []
    if (v.gruppo !== gruppo) { gruppo = v.gruppo; out.push(el('li', { class: 'comandi-gruppo', role: 'presentation', testo: gruppo })) }
    out.push(el('li', { role: 'option', id: 'voce-' + i, 'aria-selected': String(i === scelta), onclick: () => esegui(i), onmousemove: () => { if (scelta !== i) { scelta = i; segna() } } },
      v.icona ? icona(v.icona, 'segno') : el('b', { class: 'segno' }, v.segno), el('span', {}, v.testo, v.sotto && el('small', { testo: v.sotto.slice(0, 110) }))))
    return out
  }))
  segna()
}
function segna () {
  for (const li of document.querySelectorAll('.comandi-voci [role=option]')) li.setAttribute('aria-selected', String(li.id === 'voce-' + scelta))
  $('.comandi-campo').setAttribute('aria-activedescendant', 'voce-' + scelta)
  document.getElementById('voce-' + scelta)?.scrollIntoView({ block: 'nearest' })
}
function esegui (i) { const v = voci[i]; if (!v) return; chiudi(); v.fai() }

export function comandi () {
  const c = $('[data-comandi]')
  c.replaceChildren(el('div', { class: 'comandi-scatola' },
    el('input', { class: 'comandi-campo', type: 'text', role: 'combobox', 'aria-expanded': 'true', 'aria-controls': 'comandi-voci', 'aria-label': 'Cerca o chiedi', placeholder: 'Vai a, apri, cerca una nota, o scrivi cosa chiedere a Claude…', autocomplete: 'off', oninput: () => { scelta = 0; aggiorna() } }),
    el('ul', { class: 'comandi-voci', id: 'comandi-voci', role: 'listbox' }),
    el('p', { class: 'comandi-piede' }, el('kbd', { testo: '↑↓' }), ' per scegliere · ', el('kbd', { testo: 'Invio' }), ' per aprire · ', el('kbd', { testo: 'Esc' }), ' per chiudere')))
  c.addEventListener('click', e => { if (e.target === c) chiudi() })
  $('.comandi-campo', c).addEventListener('keydown', e => {
    if (e.key === 'ArrowDown') { e.preventDefault(); scelta = Math.min(voci.length - 1, scelta + 1); segna() }
    else if (e.key === 'ArrowUp') { e.preventDefault(); scelta = Math.max(0, scelta - 1); segna() }
    else if (e.key === 'Enter') { e.preventDefault(); esegui(scelta) }
    else if (e.key === 'Escape') chiudi()
  })
  addEventListener('keydown', e => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); c.hidden ? apriComandi() : chiudi() }
  })
  $('[data-apri-comandi]').addEventListener('click', () => apriComandi())
}
