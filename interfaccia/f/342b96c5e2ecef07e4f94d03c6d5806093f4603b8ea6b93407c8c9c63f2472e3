// una scheda pronta (o una delle mie) a più clienti insieme, come la card «Le schede» sul computer (27-11-2026: «ogni modifica va
// fatta sia sul telefono sia sul computer»). I kg di ognuno si mettono poi nella sua scheda
function cartaSchedeInsieme (d) {
  const possibili = d.clienti.filter(c => c.online && !c.tolto)
  if (!possibili.length) return null
  let scelta = null
  const titolo = el('input', { maxlength: 60, placeholder: 'Il titolo della scheda', 'aria-label': 'Il titolo della scheda' })
  const esercizi = el('ul', { class: 't-righe semplici' })
  // (28-11, Marco: «i messaggi toglili, metti piuttosto una nota all'invio») la nota arriva con la scheda, in Mirion Fit
  const nota = el('textarea', { rows: 2, maxlength: 400, placeholder: 'Una nota per il cliente (facoltativa)', 'aria-label': 'La nota per il cliente' })
  const spunte = possibili.map(c => el('label', { class: 't-spunta' }, el('input', { type: 'checkbox', value: c.id }), el('span', { testo: c.nome }), el('small', { testo: c.scheda ? `ora: ${c.scheda.titolo || 'senza titolo'}` : 'nessuna scheda' })))
  const dentro = el('div', { class: 't-modulo', hidden: true }, titolo, esercizi, nota, el('small', { class: 't-nota', testo: 'A chi la mandi' }), ...spunte,
    el('div', { class: 't-bottoni' }, el('button', { type: 'button', class: 't-primario', onclick: async e => {
      const chi = spunte.map(l => l.querySelector('input')).filter(i => i.checked).map(i => possibili.find(c => c.id === i.value))
      if (!chi.length) return dimmi('Spunta almeno un cliente.')
      const b = e.currentTarget; b.disabled = true; let ok = 0
      for (const c of chi) { try { await api('/api/clienti', { azione: 'scheda', id: c.id, scheda: { titolo: titolo.value.trim() || scelta.titolo, nota: nota.value.trim() || (scelta.nota ?? ''), esercizi: scelta.esercizi } }); ok++ } catch (err) { dimmi(`${c.nome}: ${err.message}`) } }
      b.disabled = false
      if (ok) {
        // (28-11, Marco: «una volta che mando da Trainer chiudi la tendina dell'elenco degli esercizi e contrassegnala come inviata»)
        dentro.hidden = true; nota.value = ''; spunte.forEach(l => { l.querySelector('input').checked = false })
        inviata.textContent = `«${titolo.value.trim() || scelta.titolo}» inviata a ${ok === 1 ? chi[0].nome : ok + ' clienti'}`; inviata.hidden = false
        scegli.value = ''; scegli.dispatchEvent(new Event('change', { bubbles: true })); scelta = null
        dimmi(`La scheda è arrivata a ${ok === 1 ? chi[0].nome : ok + ' clienti'}. I kg li metti nella scheda di ognuno.`)
      }
    } }, 'Manda')))
  const inviata = el('p', { class: 't-inviata', hidden: true })
  const scegli = el('select', { 'aria-label': 'Parti da una scheda pronta', onchange: () => {
    scelta = trovaScheda(scegli.value); dentro.hidden = !scelta; if (!scelta) return
    inviata.hidden = true
    titolo.value = scelta.titolo
    esercizi.replaceChildren(...scelta.esercizi.map(x => el('li', {}, el('b', { testo: x.nome }), el('small', { testo: `${x.serie} × ${x.rip}${x.recupero ? ` · recupero ${x.recupero} s` : ''}` }))))
  } }, ...opzioni('Scegli una scheda pronta…'))
  caricaMie(api).then(cambiate => { if (cambiate) scegli.replaceChildren(...opzioni('Scegli una scheda pronta…')) })
  return carta('Manda una scheda', 'a uno o più clienti', el('div', { class: 't-modulo' }, scegli), inviata, dentro)
}

