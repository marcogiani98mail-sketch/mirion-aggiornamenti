// Marco, 25-11 sera: «le icone in alto servono solo per inviare card sulla scrivania»: un clic e la card va in fondo, accesa
// Le cartelle piccole delle estensioni (Marco, 27-11-2026: «le cartelle che hai creato non mi piacciono, piuttosto apri delle
// cartelle più piccoline che tengono l'estensione» · «quelle libere le metti come Mirion Task come estensione»): con opz.cartelle
// (id → { chiave, nome, icona | img, sotto }) le icone stanno in piccole cartelle, una per estensione (Mirion Task, Mirion Fit…).
// Un clic apre la cartella sotto la fila: dentro tutte le sue card, divise per «sotto»; quelle già sulla scrivania hanno la spunta
// e un clic le toglie, le altre con un clic ci vanno. La cartella aperta resta aperta finché non la richiudi
let cartellaAperta = null
// la card di un software («p.piatto.peso») ha l'icona e la parola della sua card («peso»), non del software
const chiaveCard = id => id.replace(/^p\.[^.]+\./, '')
export function iconeCard (contenuti, ridisegna, { titoli = TITOLI, dove = scrivania, qui = 'sulla scrivania', cartelle = null } = {}) {
  const tutte = (dove()?.riquadri ?? []).filter(r => contenuti[r.id] && titoli[r.id])
  const fuori = tutte.filter(r => r.nascosto)
  if (!cartelle && !fuori.length) return ''
  const metti = id => {
    const lay = dove(), r = lay?.riquadri.find(c => c.id === id)
    if (!r) return
    const resto = lay.riquadri.filter(c => c !== r)
    r.nascosto = false; r.gruppo = null; r.piccolo = false
    lay.riquadri = [...resto.filter(c => !c.nascosto), r, ...resto.filter(c => c.nascosto)] // in fondo alle card accese
    salva({ subito: true }); ridisegna()
  }
  const togli = id => { const r = dove()?.riquadri.find(c => c.id === id); if (!r) return; r.nascosto = true; r.gruppo = null; salva({ subito: true }); ridisegna() }
  const icona = (r, classe = '') => el('button', {
    type: 'button', class: 'icona-card' + classe, 'data-id': r.id, 'aria-pressed': cartelle ? String(!r.nascosto) : null,
    title: r.nascosto ? `Metti «${titoli[r.id]}» ${qui}` : `«${titoli[r.id]}» è ${qui}: clic per toglierla`, onclick: () => r.nascosto ? metti(r.id) : togli(r.id) },
  ic(segno(chiaveCard(r.id))), el('span', { class: 'icona-card-nome', testo: parola(chiaveCard(r.id), String(titoli[r.id]).split(' · ').pop()) }), r.nascosto ? null : el('span', { class: 'icona-card-su', 'aria-hidden': 'true' }, ic('check')))
  if (!cartelle) return el('nav', { class: 'icone-card', 'aria-label': `Le card da mettere ${qui}` }, ...fuori.map(r => icona(r)))

  // le cartelle, nell'ordine in cui compaiono le estensioni; le card senza cartella restano icone sciolte come prima
  let gruppi = new Map(); const sciolte = []
  for (const r of tutte) {
    const c = cartelle(r.id)
    if (!c) { if (r.nascosto) sciolte.push(r); continue }
    if (!gruppi.has(c.chiave)) gruppi.set(c.chiave, { ...c, carte: [] })
    gruppi.get(c.chiave).carte.push({ r, sotto: c.sotto ?? '' })
  }
  if (!gruppi.has(cartellaAperta)) cartellaAperta = null
  if (gruppi.has('task')) { const t = gruppi.get('task'); gruppi.delete('task'); gruppi = new Map([['task', t], ...gruppi]) } // Mirion Task per prima
  const segnoCartella = c => c.img ? el('img', { src: c.img, alt: '' }) : ic(c.icona ?? 'folder-simple')
  const fila = el('nav', { class: 'icone-card cartelle-estensioni', 'aria-label': `Le estensioni e le loro card da mettere ${qui}` },
    ...[...gruppi.values()].map(c => {
      const su = c.carte.filter(x => !x.r.nascosto).length
      return el('button', { type: 'button', class: 'cartella-est' + (cartellaAperta === c.chiave ? ' aperta' : ''), 'data-cartella': c.chiave, 'aria-expanded': String(cartellaAperta === c.chiave),
        title: `${c.nome}: ${c.carte.length} card, ${su} ${qui}`, onclick: () => { cartellaAperta = cartellaAperta === c.chiave ? null : c.chiave; ridisegna() } },
      el('span', { class: 'cartella-est-segno', 'aria-hidden': 'true' }, segnoCartella(c)), el('span', { class: 'cartella-est-nome', testo: c.nome }),
      el('small', { class: 'cartella-est-quante', testo: `${su}/${c.carte.length}` }), ic(cartellaAperta === c.chiave ? 'caret-up' : 'caret-down'))
    }),
    ...sciolte.map(r => icona(r)))
  const aperta = gruppi.get(cartellaAperta)
  if (!aperta) return fila
  const perSotto = new Map()
  for (const x of aperta.carte) { if (!perSotto.has(x.sotto)) perSotto.set(x.sotto, []); perSotto.get(x.sotto).push(x.r) }
  return el('div', { class: 'cartelle-blocco' }, fila,
    el('section', { class: 'cartella-est-dentro', 'aria-label': aperta.nome },
      el('header', {}, el('span', { class: 'cartella-est-segno', 'aria-hidden': 'true' }, segnoCartella(aperta)), el('strong', { testo: aperta.nome }),
        el('small', { class: 'sopra', testo: 'un clic mette la card ' + qui + ', con la spunta la toglie' }),
        el('button', { type: 'button', class: 'quieto piccolo', 'aria-label': 'Chiudi la cartella', onclick: () => { cartellaAperta = null; ridisegna() } }, ic('x'))),
      ...[...perSotto.entries()].map(([sotto, carte]) => el('div', { class: 'cartella-est-gruppo' },
        sotto ? el('small', { class: 'cartella-est-sotto', testo: sotto }) : null,
        el('div', { class: 'icone-card' }, ...carte.map(r => icona(r, r.nascosto ? '' : ' sulla')))))))
}

// Esc chiude lo schermo intero
addEventListener('keydown', e => { if (e.key === 'Escape' && intero && !document.querySelector('[aria-modal="true"]:not([hidden])')) { intero = null; dispatchEvent(new CustomEvent('su-misura')) } })
export const aperta = () => intero

// F11: a schermo intero la card sotto il mouse (o l'ultima toccata), e di nuovo F11 la richiude (Marco, 26-11: «con F11 posso
// metterla a schermo intero»). Mirion non ha il menu di Electron, quindi F11 è libero
let toccata = null
addEventListener('pointerover', e => { const b = e.target.closest?.('.griglia-riquadri > .riquadro'); if (b) toccata = b.dataset.id })
addEventListener('keydown', e => {
  if (e.key !== 'F11' || e.repeat) return
  const id = intero ?? (toccata && document.querySelector(`.griglia-riquadri > .riquadro[data-id="${CSS.escape(toccata)}"]`) ? toccata : null)
  if (!id) return
  e.preventDefault()
  intero = intero ? null : id; dispatchEvent(new CustomEvent('su-misura'))
})

// per il tasto destro (tasto-destro.js): le stesse mosse dei pulsanti, chiamate per id; dopo ognuna la scrivania si ridisegna
export const mosse = {
  riq, membri, gruppo,
  lista: id => gruppo(id) ? membri(id) : [riq(id)].filter(Boolean),
  schermoIntero (id) { intero = intero === id ? null : id; avvisa() },
  misura (id, campi) { mosse.lista(id).forEach(r => Object.assign(r, campi)); salva(); avvisa() },
  togli (id) { const g = gruppo(id), r = riq(g ? g.scelto : id); if (r) { r.nascosto = true; r.gruppo = null; salva(); avvisa() } },
  estrai (g, chi) { estrai(g, chi); salva(); avvisa() },
  sciogli (g) { membri(g).forEach(r => { r.gruppo = null }); salva(); avvisa() },
  unisci (a, b) { unisci(a, b); salva(); avvisa() },
  mostra (g, chi) { const c = gruppo(g); if (c) { c.scelto = chi; salva(); avvisa() } },
}

// Tutte le card dentro la dashboard iniziale (Marco, 26-11-2026 notte: «integra tutte le card in qualche modo dentro la dashboard
// iniziale, anche le icone apribili nella dashboard anche ingrandendola; lascia le card se qualcuno vuole averle»): nella card
// principale di una sezione (Mirion Fit «Oggi», Mirion Trainer «I numeri») una fila di icone, una per ogni altra card; un clic la
// apre lì dentro, un altro clic (o la ✕) la chiude. Se ne aprono anche più insieme: con la card ingrandita o a schermo intero si
// mettono una accanto all'altra. Le card singole restano dove sono. Quali sono aperte si ricorda (per sezione, su questo computer).
const APERTE = {}
const leggiAperte = chiave => {
  if (!APERTE[chiave]) { try { APERTE[chiave] = new Set(JSON.parse(localStorage.getItem('mirion:dentro:' + chiave) ?? '[]')) } catch { APERTE[chiave] = new Set() } }
  return APERTE[chiave]
}
const scriviAperte = chiave => { try { localStorage.setItem('mirion:dentro:' + chiave, JSON.stringify([...APERTE[chiave]])) } catch {} }
// voci: [[id, titolo]]; costruisci(id) dà il contenuto (la card com'è, senza i suoi comandi); in più: un elemento in fondo alla fila
export function carteDentro (chiave, voci, costruisci, { inPiu = null } = {}) {
  const aperte = leggiAperte(chiave)
  for (const id of [...aperte]) if (!voci.some(([v]) => v === id)) aperte.delete(id)
  const box = el('div', { class: 'carte-dentro' }), fila = el('nav', { class: 'icone-card icone-dentro', 'aria-label': 'Le altre card, da aprire qui' }), pannelli = el('div', { class: 'dentro-pannelli' })
  const disegna = () => {
    fila.replaceChildren(...voci.map(([id, t]) => el('button', {
      type: 'button', class: 'icona-card' + (aperte.has(id) ? ' aperta' : ''), 'data-dentro': id, 'aria-pressed': String(aperte.has(id)),
      title: aperte.has(id) ? `Chiudi «${t}»` : `Apri «${t}» qui`,
      onclick: e => { e.stopPropagation(); if (aperte.has(id)) aperte.delete(id); else aperte.add(id); scriviAperte(chiave); disegna() },
    }, ic(segno(id)), el('span', { class: 'icona-card-nome', testo: parola(id, t) }))), inPiu ?? '')
    pannelli.replaceChildren(...voci.filter(([id]) => aperte.has(id)).map(([id, t]) => el('div', { class: 'dentro-pannello', 'data-dentro': id },
      el('button', { type: 'button', class: 'quieto piccolo dentro-chiudi', 'aria-label': `Chiudi «${t}»`, title: 'Chiudi', onclick: e => { e.stopPropagation(); aperte.delete(id); scriviAperte(chiave); disegna() } }, ic('x')),
      costruisci(id))))
    pannelli.hidden = !aperte.size
  }
  disegna(); box.append(fila, pannelli); return box
}
