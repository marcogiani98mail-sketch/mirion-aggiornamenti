// la scheda dal telefono: una riga per esercizio, «Squat 4x8 80» (nome, serie×ripetizioni, kg)
function cartaScheda (c) {
  if (!c.online) return carta('La scheda', '', el('p', { class: 't-nota', testo: 'La scheda e i messaggi si mandano ai clienti di Mirion Fit online. Invitalo dal computer: stanza Clienti → «Invita su Mirion Fit online».' }))
  const s = c.scheda
  const righe = el('textarea', { rows: 6, name: 'righe', placeholder: 'Squat 4x8 80\nPanca piana 4x8 60\nLat machine 3x10 50\nPlank 3x45', 'aria-label': 'Gli esercizi, uno per riga' })
  righe.value = (s?.esercizi ?? []).map(e => `${e.nome} ${e.serie ?? 3}x${e.rip ?? 10}${e.kg ? ' ' + String(e.kg).replace('.', ',') : ''}`).join('\n')
  const titolo = el('input', { name: 'titolo', placeholder: 'Il titolo (es. Forza A)', value: s?.titolo ?? '', maxlength: 60, 'aria-label': 'Il titolo della scheda' })
  // in base a come va (26-11-2026): «Proponi» riscrive le righe con i kg da provare (dall'ultima volta); se è vuota, con gli
  // esercizi che fa di più
  const andamento = Array.isArray(c.piatto?.andamento) ? c.piatto.andamento : []
  const rigaDi = a => `${a.nome} ${a.serie?.length || 3}x${a.rip ?? 10}${(a.proposta?.kg ?? a.kg) ? ' ' + String(a.proposta?.kg ?? a.kg).replace('.', ',') : ''}`
  const proponi = () => {
    const perNome = new Map(andamento.map(a => [a.nome.toLowerCase(), a]))
    const scritte = righe.value.split('\n').map(r => r.trim()).filter(Boolean)
    righe.value = scritte.length ? scritte.map(r => { const a = [...perNome.entries()].find(([n]) => r.toLowerCase().startsWith(n))?.[1]; return a ? rigaDi(a) : r }).join('\n') : andamento.slice(0, 6).map(rigaDi).join('\n')
    dimmi('Ecco i kg da provare, da come è andata l’ultima volta.')
  }
  // «Parti da» (27-11-2026, Marco: «dai la possibilità da Mirion Trainer di portare schedine al proprio cliente»): una scheda pronta
  // o una delle mie riempie le righe; «Salva fra le mie» la tiene per gli altri clienti, anche sul computer
  let base = new Map()
  const scegli = el('select', { 'aria-label': 'Parti da una scheda pronta', onchange: () => {
    const sch = trovaScheda(scegli.value); scegli.value = ''; if (!sch) return
    titolo.value = sch.titolo; base = new Map(sch.esercizi.map(e => [e.nome.toLowerCase(), e]))
    righe.value = sch.esercizi.map(e => `${e.nome} ${e.serie ?? 3}x${e.rip ?? 10}${e.kg ? ' ' + String(e.kg).replace('.', ',') : ''}`).join('\n')
    dimmi(`«${sch.titolo}»: aggiungi i kg dopo ogni riga, poi «Manda la scheda».`)
  } }, ...opzioni('Parti da una scheda pronta…'))
  caricaMie(api).then(cambiate => { if (cambiate) scegli.replaceChildren(...opzioni('Parti da una scheda pronta…')) })
  const comeVa = andamento.length ? el('ul', { class: 't-righe semplici' }, ...andamento.slice(0, 6).map(a => el('li', {}, el('b', { testo: a.nome }),
    el('small', { testo: `ultima: ${(a.serie ?? []).map(x => x.kg ? `${String(x.kg).replace('.', ',')} kg × ${x.rip}` : `${x.rip} rip.`).join(' · ')}${a.proposta ? ` → ${String(a.proposta.kg).replace('.', ',')} kg` : ''}` })))) : null
  return carta('La scheda', s ? `ora: ${s.titolo || 'senza titolo'}` : 'nessuna', comeVa, el('form', { class: 't-modulo', onsubmit: async e => {
    e.preventDefault()
    // quello che il telefono non mostra (la nota, il recupero, l'esercizio della libreria scritti dal computer) resta com'era
    // per gli esercizi con lo stesso nome: prima si perdeva (analisi del 26-11, T1)
    const prima = new Map((s?.esercizi ?? []).map(e => [String(e.nome ?? '').trim().toLowerCase(), e]))
    const tieni = nome => { const v = prima.get(nome.toLowerCase()) ?? base.get(nome.toLowerCase()); return { esercizioId: v?.esercizioId ?? '', recupero: v?.recupero ?? null, note: v?.note ?? '' } }
    const esercizi = righe.value.split('\n').map(r => r.trim()).filter(Boolean).slice(0, 20).map(r => {
      const m = /^(.*?)\s+(\d{1,2})\s*[x×]\s*([\d-]{1,7})(?:\s+(\d+(?:[.,]\d+)?))?\s*(?:kg)?$/i.exec(r)
      const nome = m ? m[1].trim() : r
      return m ? { ...tieni(nome), nome, serie: +m[2], rip: m[3], kg: m[4] ? +m[4].replace(',', '.') : null } : { ...tieni(nome), nome, serie: 3, rip: '10', kg: null }
    })
    if (!esercizi.length) return dimmi('Scrivi almeno un esercizio.')
    try { await api('/api/clienti', { azione: 'scheda', id: c.id, scheda: { titolo: titolo.value.trim(), nota: s?.nota ?? '', esercizi } }); dimmi(`La scheda è arrivata a ${c.nome}.`) } catch (err) { dimmi(err.message) }
  } }, scegli, titolo, righe, el('div', { class: 't-bottoni' }, andamento.length ? el('button', { type: 'button', onclick: proponi }, 'Proponi in base a come va') : null,
    el('button', { type: 'button', onclick: () => { const es = righe.value.split('\n').map(r => r.trim()).filter(Boolean).map(r => { const m = /^(.*?)\s+(\d{1,2})\s*[x×]\s*([\d-]{1,7})(?:\s+(\d+(?:[.,]\d+)?))?/i.exec(r); return m ? { nome: m[1].trim(), serie: +m[2], rip: m[3], kg: m[4] ? +m[4].replace(',', '.') : null } : { nome: r, serie: 3, rip: '10', kg: null } }); dimmi(salvaMia({ titolo: titolo.value, esercizi: es }) ? 'Salvata fra le tue schede: la ritrovi in «Parti da».' : 'Scrivi almeno un esercizio.') } }, 'Salva fra le mie'),
    el('button', { class: 't-primario' }, 'Manda la scheda'))))
}

