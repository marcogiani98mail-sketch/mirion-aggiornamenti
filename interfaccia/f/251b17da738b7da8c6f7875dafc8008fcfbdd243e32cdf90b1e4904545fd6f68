/* Il movimento di Mirion Trainer (28-11-2026, Marco: «anima tutta l'app bene con tecniche forti e rilassanti»), come in Mirion Fit
   (public/movimento.css nel progetto di Fit). Le animazioni che partono dai dati (cascata, numeri, barre, tendine, respiro) stanno in
   js/trainer-movimento.js; qui il tocco e il passaggio fra le pagine della barra. trainer-telefono.css spegne ogni transizione con
   «* { transition: none !important }»: qui, solo per quello che serve, la regola si supera con selettori più precisi (html.mv …,
   si carica dopo). Solo transform/opacity/filter. Con «riduci movimento» il tocco e il passaggio restano fermi. */

/* ——— il tocco: si abbassa un poco (.96) e torna con una molla leggera; il tasto pieno manda un bagliore del colore del tema ——— */
html.mv :is(button, .btn, a.t-bottone, .t-chip, .t-barra a, .t-primario, .t-righe a, .t-guarda a, .t-classifica a, a.cr-tile, .t-cima a) {
  transition: transform .44s var(--molla, cubic-bezier(.3,1.25,.5,1)), filter .5s cubic-bezier(.22,1,.36,1), background-color .28s ease, opacity .28s ease, color .28s ease !important;
  -webkit-tap-highlight-color: transparent;
}
html.mv :is(button, .btn, a.t-bottone, .t-chip, .t-barra a, .t-primario, a.cr-tile, .t-cima a):active:not(:disabled) {
  transform: scale(.96); transition: transform .12s cubic-bezier(.22,1,.36,1), filter .12s ease, background-color .12s ease !important;
}
/* le righe larghe si abbassano meno: .96 su tutta la larghezza sarebbe un salto */
html.mv :is(.t-righe a, .t-guarda a, .t-classifica a):active { transform: scale(.985); transition: transform .12s cubic-bezier(.22,1,.36,1) !important; }
html.mv .t-primario { filter: drop-shadow(0 0 0 transparent); }
html.mv .t-primario:active:not(:disabled) { filter: drop-shadow(0 0 14px color-mix(in oklch, var(--accento-2, #f08fb8) 60%, transparent)); }
html.mv .cr-barra i, html.mv .t-classifica i::after { transform-origin: left center; }
html.mv .cr-barre > div > i { transform-origin: center bottom; }

/* ——— fra le pagine della barra (View Transitions): la pagina vecchia sfuma via, la nuova entra a cascata (trainer-movimento.js);
   la voce accesa della barra scivola da una voce all'altra. Il resto (testata, stelle) resta fermo ——— */
html.mv-vt #vista { view-transition-name: mv-schermo; }
html.mv-vt .t-barra a[aria-current="true"] { view-transition-name: mv-scheda; }
::view-transition-old(root), ::view-transition-new(root) { animation: none !important; }
::view-transition-group(mv-schermo) { animation: none !important; }
::view-transition-old(mv-schermo) { animation: mv-sfuma-via .26s cubic-bezier(.4,0,1,1) both !important; }
::view-transition-new(mv-schermo) { animation: mv-appare .18s ease-out both !important; }
::view-transition-group(mv-scheda) { animation-duration: .46s !important; animation-timing-function: var(--molla, cubic-bezier(.3,1.25,.5,1)) !important; }
::view-transition-old(mv-scheda), ::view-transition-new(mv-scheda) { animation-duration: .3s !important; height: 100%; }
@keyframes mv-sfuma-via { to { opacity: 0; filter: blur(2px); } }
@keyframes mv-appare { from { opacity: 0; } }

@media (prefers-reduced-motion: reduce) {
  html.mv :is(button, .btn, a.t-bottone, .t-chip, .t-barra a, .t-primario, .t-righe a, .t-guarda a, .t-classifica a, a.cr-tile, .t-cima a) { transition: opacity .12s linear, background-color .12s linear !important; }
  html.mv :is(button, .btn, a.t-bottone, .t-chip, .t-barra a, .t-primario, .t-righe a, .t-guarda a, .t-classifica a, a.cr-tile, .t-cima a):active { transform: none !important; filter: none !important; }
}
