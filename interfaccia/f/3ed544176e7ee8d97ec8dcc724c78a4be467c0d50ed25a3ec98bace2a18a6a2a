// la chat con il cliente, con le risposte veloci per gli avvisi
function cartaChat (c) {
  if (!c.online) return null
  const fila = el('div', { class: 't-chat' })
  const ora = q => new Date(q).toLocaleString('it-IT', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })
  const disegna = mm => { fila.replaceChildren(...(mm.length ? mm.slice(-40).map(m => el('div', { class: `t-bolla ${m.da === 'trainer' ? 'mia' : 'sua'} ${m.tema === 'dolore' ? 'dolore' : ''}` }, m.da !== 'trainer' && TEMI[m.tema] ? el('small', { testo: TEMI[m.tema] }) : null, el('p', { testo: m.testo }), el('time', { testo: ora(m.quando) }))) : [el('p', { class: 't-vuoto', testo: `Scrivi a ${c.nome}: gli arriva su Mirion Fit.` })])); fila.scrollTop = fila.scrollHeight }
  disegna(c.messaggi ?? [])
  const testo = el('textarea', { rows: 1, placeholder: `Scrivi a ${c.nome}`, 'aria-label': 'Il messaggio', maxlength: 1000 })
  const veloci = ['Come va il fastidio? Oggi scarica pure e salta gli esercizi che fanno male.', 'Grande seduta, continua così!', 'Ti aggiorno la scheda entro stasera.']
  const manda = async t => {
    if (!t.trim()) return
    try { await api('/api/clienti', { azione: 'messaggio', id: c.id, testo: t }); testo.value = ''; const n = await api('/api/clienti/uno?id=' + encodeURIComponent(c.id)); disegna(n.messaggi ?? []); letti = 0 } catch (err) { dimmi(err.message) }
  }
  return carta('I messaggi', 'su Mirion Fit', fila,
    el('div', { class: 't-veloci' }, ...veloci.map(t => el('button', { type: 'button', onclick: () => { testo.value = t; testo.focus() } }, t.split(/[.!?]/)[0]))),
    el('form', { class: 't-scrivi', onsubmit: e => { e.preventDefault(); manda(testo.value) } }, testo, el('button', { class: 't-primario t-tondo', 'aria-label': 'Manda' }, '➤')))
}

// ---- Personalizza (Marco, 27-11-2026: «fai personalizzare anche l'area del trainer»), come in Mirion Fit ----
const CURSORI = [['accento', 'Il colore', 0, 360, '°'], ['secondo', 'Il secondo colore', 0, 360, '°'], ['saturazione', 'Quanto è vivo', 0, 200, '%'], ['buio', 'Fondo nero', 0, 100, '%']]
function vistaPersonalizza (v) {
  const s = AS.leggiColori(), k = AS.cursori(s)
  const tondo = x => ({ background: `linear-gradient(135deg, oklch(.64 .17 ${x.accento}), oklch(.72 .15 ${x.secondo}))` })
  const sfumature = el('div', { class: 't-sfumature', role: 'group', 'aria-label': 'Le sfumature' }, ...AS.sfumature().map(x =>
    el('button', { type: 'button', class: 't-sfumatura' + (s?.tema === x.id ? ' sel' : ''), 'aria-pressed': String(s?.tema === x.id), onclick: () => { AS.salvaColori({ tema: x.id }); vistaPersonalizza(v) } },
      el('i', { style: tondo(x) }), el('span', { testo: x.nome }))))
  const cursori = CURSORI.map(([id, nome, min, max, u]) => {
    const valore = el('b', { testo: Math.round(k[id]) + u })
    const r = el('input', { type: 'range', min, max, step: 1, value: Math.round(k[id]), 'aria-label': nome, oninput: () => {
      valore.textContent = r.value + u
      const ora = AS.leggiColori() ?? { tema: 'viola' }; AS.salvaColori({ ...ora, colori: { ...AS.cursori(ora), [id]: +r.value } })
    } })
    return el('label', { class: 't-cursore' }, el('span', {}, el('span', { testo: nome }), valore), r)
  })
  const elencoCard = vista => {
    const { ordine, nascoste } = AS.sceltaCard(vista)
    const cambia = (ord, nas) => { AS.salvaCard(vista, { ordine: ord, nascoste: nas }); vistaPersonalizza(v) }
    const sposta = (i, d) => { const o = [...ordine]; [o[i], o[i + d]] = [o[i + d], o[i]]; cambia(o, nascoste) }
    return el('ul', { class: 't-righe t-personalizza' }, ...ordine.map((id, i) => el('li', { class: nascoste.includes(id) ? 'spenta' : '' },
      el('b', { testo: AS.CARD[vista][id] }),
      el('span', { class: 't-fila' },
        el('button', { type: 'button', class: 't-tondo piccolo', 'aria-label': 'Più su', disabled: i === 0, onclick: () => sposta(i, -1) }, '↑'),
        el('button', { type: 'button', class: 't-tondo piccolo', 'aria-label': 'Più giù', disabled: i === ordine.length - 1, onclick: () => sposta(i, 1) }, '↓'),
        el('button', { type: 'button', class: 't-tondo piccolo', 'aria-label': nascoste.includes(id) ? 'Mostra' : 'Nascondi', onclick: () => cambia(ordine, nascoste.includes(id) ? nascoste.filter(x => x !== id) : [...nascoste, id]) }, nascoste.includes(id) ? '○' : '●')))))
  }
  metti(v, el('h1', { class: 't-titolo', testo: 'Personalizza' }),
    el('p', { class: 't-sotto', testo: 'I colori e le card di Oggi e di Clienti. Valgono su questo telefono.' }),
    carta('I colori', s ? 'scelti da te' : 'quelli di sempre', sfumature, el('div', { class: 't-cursori' }, ...cursori),
      el('div', { class: 't-bottoni' }, el('button', { type: 'button', disabled: !s, onclick: () => { AS.salvaColori(null); vistaPersonalizza(v) } }, 'Torna ai colori di sempre'))),
    carta('Le card di Oggi', '● si vede · ○ nascosta', elencoCard('oggi')),
    carta('Le card di Clienti', '● si vede · ○ nascosta', elencoCard('clienti'),
      el('div', { class: 't-bottoni' }, el('button', { type: 'button', onclick: () => { AS.salvaCard('oggi', null); AS.salvaCard('clienti', null); vistaPersonalizza(v) } }, 'Rimetti le card come all’inizio'))))
}

// ---- il giro delle viste ----
async function mostra () {
  const [nome, ...resto] = (location.hash.slice(1) || 'oggi').split('/'), v = $('#vista')
  for (const a of document.querySelectorAll('.t-barra a')) a.setAttribute('aria-current', String(a.dataset.v === nome || (nome === 'cliente' && a.dataset.v === 'clienti')))
  try {
    if (nome === 'cliente' && resto[0]) await vistaCliente(v, decodeURIComponent(resto.join('/')))
    else if (nome === 'clienti') await vistaClienti(v)
    else if (nome === 'squadra') await vistaSquadra(v)
    else if (nome === 'personalizza') vistaPersonalizza(v)
    else await vistaOggi(v)
    scrollTo(0, 0)
  } catch (e) { metti(v, el('p', { class: 't-vuoto', testo: e.message || (online ? 'Mirion Fit online non risponde: riprova fra poco.' : 'Il computer non risponde: Mirion è acceso?') })) }
}
addEventListener('hashchange', mostra)
