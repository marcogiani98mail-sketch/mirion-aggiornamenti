const metti = (v, ...x) => v.replaceChildren(...x.flat().filter(n => n != null && n !== false))
let avviso = null
function dimmi (testo) {
  avviso?.remove()
  avviso = el('div', { class: 't-avviso', role: 'status', testo }); document.body.append(avviso)
  setTimeout(() => avviso?.remove(), 3800)
}
