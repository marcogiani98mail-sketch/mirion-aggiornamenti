<meta name="apple-mobile-web-app-title" content="Mirion">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="apple-touch-icon" href="/icone/mirion-180.png">
<title>Mirion</title>
<link rel="icon" href="/marchio.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Fraunces:opsz,wght,SOFT@9..144,400..700,0..100&family=JetBrains+Mono:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="/stile/base.css">
<link rel="stylesheet" href="/stile/stanze.css">
<link rel="stylesheet" href="/stile/scrivania.css">
<link rel="stylesheet" href="/stile/primo.css">
<link rel="stylesheet" href="/stile/su-misura.css">
<link rel="stylesheet" href="/stile/chat.css">
<link rel="stylesheet" href="/stile/premium.css">
<link rel="stylesheet" href="/stile/aurora.css">
<link rel="stylesheet" href="/stile/cruscotto.css">
<link rel="stylesheet" href="/stile/clienti.css">
<link rel="stylesheet" href="/stile/claude.css">
<link rel="stylesheet" href="/stile/stili.css">
<link rel="stylesheet" href="/stile/flussi.css">
</head>
<body>
<header class="cima">
  <a class="marchio" href="#scrivania" aria-label="Mirion, la scrivania"><img src="/marchio.svg" alt="" width="26" height="26"><span>Mirion</span></a>
  <button type="button" class="cerca-tutto" data-apri-comandi><span>Cerca note, accessi, comandi…</span><kbd>Ctrl K</kbd></button>
  <nav class="strumenti" aria-label="I tuoi strumenti" data-dock></nav>
  <time class="orologio" data-orologio></time>
</header>

<nav class="stanze" aria-label="Le stanze di Mirion" data-stanze>
  <a href="#scrivania" data-stanza="scrivania"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="12" rx="2.5"/><path d="M8 20h8M12 16v4"/></svg><span>Scrivania</span></a>
  <a href="#telefoni" data-stanza="telefoni"><svg viewBox="0 0 24 24"><rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 18.5h2"/></svg><span>Telefoni</span></a>
  <a href="#scadute" data-stanza="scadute"><svg viewBox="0 0 24 24"><rect x="3.5" y="4" width="17" height="16" rx="3"/><path d="M7.5 10l2 2 3.5-4M7.5 16h9"/></svg><span>Task</span><b class="bollino" data-bollino hidden title="scadute"></b></a>
  <a href="#lavoro" data-stanza="lavoro"><svg viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="13" rx="3"/><path d="M8.5 7V5.5A1.5 1.5 0 0 1 10 4h4a1.5 1.5 0 0 1 1.5 1.5V7M3 12.5h18"/></svg><span>Lavoro</span></a>
  <a href="#lavagne" data-stanza="lavagne"><svg viewBox="0 0 24 24"><path d="M4 20l4-1 11-11-3-3L5 16z"/><path d="M14 6l3 3M4 20h16"/></svg><span>Lavagne</span></a>
  <a href="#flussi" data-stanza="flussi"><svg viewBox="0 0 24 24"><circle cx="5" cy="6" r="2"/><circle cx="5" cy="18" r="2"/><circle cx="19" cy="12" r="2"/><path d="M7 6h4a3 3 0 0 1 3 3v0a3 3 0 0 0 3 3M7 18h4a3 3 0 0 0 3-3v0a3 3 0 0 1 3-3"/></svg><span>Flussi</span></a>
  <a href="#cerca" data-stanza="cerca"><svg viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6"/><path d="M15 15l5 5"/></svg><span>Cerca</span></a>
  <a href="#diario" data-stanza="diario"><svg viewBox="0 0 24 24"><path d="M6 3.5h11a1.5 1.5 0 0 1 1.5 1.5v14a1.5 1.5 0 0 1-1.5 1.5H6a1.5 1.5 0 0 1-1.5-1.5V5A1.5 1.5 0 0 1 6 3.5z"/><path d="M8.5 3.5v17M11.5 8h4M11.5 11.5h4"/></svg><span>Diario</span></a>
  <a href="#conti" data-stanza="conti"><svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="13" rx="2.5"/><path d="M3 10h18M7 15h4"/></svg><span>Clienti e conti</span></a>
  <a href="#calendario" data-stanza="calendario"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="2"/></svg><span>Calendario</span></a>
  <a href="#impostazioni" class="in-fondo"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M5.3 18.7l2.1-2.1M16.6 7.4l2.1-2.1"/></svg><span>Impostazioni</span></a>
</nav>

<main data-palco>
  <section id="scrivania" class="stanza" data-sezione></section>
  <section id="telefoni" class="stanza" data-sezione hidden></section>
  <section id="scadute" class="stanza" data-sezione hidden></section>
  <section id="lavoro" class="stanza" data-sezione hidden></section>
  <section id="lavagne" class="stanza piena" data-sezione hidden></section>
  <section id="flussi" class="stanza" data-sezione hidden></section>
  <section id="cerca" class="stanza" data-sezione hidden></section>
  <section id="notizie" class="stanza" data-sezione hidden></section>
  <section id="prodotto" class="stanza" data-sezione hidden></section>
  <section id="diario" class="stanza" data-sezione hidden></section>
  <section id="ia" class="stanza" data-sezione hidden></section>
  <section id="calendario" class="stanza" data-sezione hidden></section>
  <section id="impostazioni" class="stanza" data-sezione hidden></section>
  <section id="gestionale" class="stanza piena" data-sezione hidden></section>
  <section id="conti" class="stanza" data-sezione hidden></section>
  <section id="claude" class="stanza" data-sezione hidden></section>
  <section id="clienti" class="stanza" data-sezione hidden></section>
  <section id="importa" class="stanza" data-sezione hidden></section>
</main>

<div class="comandi" data-comandi hidden role="dialog" aria-modal="true" aria-label="Cerca e comandi"></div>
<div class="guida" data-guida hidden role="dialog" aria-modal="true"></div>
<div class="notifiche" data-notifiche role="status" aria-live="polite"></div>

<script>window.EXCALIDRAW_ASSET_PATH = '/vendor/excalidraw/'</script>
<script src="/vendor/react/react.production.min.js"></script>
<script src="/vendor/react-dom/react-dom.production.min.js"></script>
<script src="/vendor/excalidraw/excalidraw.production.min.js"></script>
<script src="/js/app.js" type="module"></script>
</body>
</html>
