// «Le mie schede»: quelle che il trainer salva per riusarle, al massimo 40. Dal 27-11 (Marco: «deve essere collegata alla versione
// da computer di Claudio anche se non ce l'ha ancora») stanno nella Mirion del computer e, con Mirion Fit online, sul server per
// quel trainer: l'app sul telefono, la web app e la Mirion sul computer (anche una installata dopo) hanno le stesse. Qui ne resta
// una copia, per vederle subito e se la rete non c'è; quella che arriva dal computer o dal server vince.
const CHIAVE = 'mirion:schede-mie', QUANDO = 'mirion:schede-mie-quando'
const leggi = k => { try { return localStorage.getItem(k) } catch { return null } }
const scrivi = (k, v) => { try { localStorage.setItem(k, v); return true } catch { return false } }
export function mieSchede () { try { const x = JSON.parse(leggi(CHIAVE) ?? '[]'); return Array.isArray(x) ? x : [] } catch { return [] } }
let caricate = null, mandaA = null
// le prende dal computer (o dal server, sulla web app); ridà true se sono cambiate. Una volta ogni 30 secondi al massimo
export function caricaMie (api) {
  mandaA = api
  if (caricate && Date.now() - caricate.quando < 30_000) return caricate.p
  const prima = leggi(CHIAVE) ?? '[]'
  const p = api('/api/clienti', { azione: 'mie-schede' }).then(async r => {
    if (!Array.isArray(r?.schede)) return false
    // mai salvate di là (o un server di prima): quelle di qui partono, così non si perdono
    if (!r.quando) { if (mieSchede().length) await manda(); return false }
    if (r.quando === leggi(QUANDO)) return false
    scrivi(CHIAVE, JSON.stringify(r.schede.slice(0, 40))); scrivi(QUANDO, r.quando)
    return (leggi(CHIAVE) ?? '[]') !== prima
  }).catch(() => false)
  caricate = { quando: Date.now(), p }
  return p
}
async function manda () {
  if (!mandaA) return
  try { const r = await mandaA('/api/clienti', { azione: 'mie-schede', schede: mieSchede() }); if (r?.quando) { scrivi(CHIAVE, JSON.stringify(r.schede ?? mieSchede())); scrivi(QUANDO, r.quando) } } catch { /* resta qui: parte alla prossima */ }
}
export function salvaMia (scheda) {
  const titolo = String(scheda?.titolo || '').trim() || 'Senza titolo', esercizi = (scheda?.esercizi ?? []).filter(e => e?.nome).slice(0, 20)
  if (!esercizi.length) return false
  const resto = mieSchede().filter(s => s.titolo.toLowerCase() !== titolo.toLowerCase())
  if (!scrivi(CHIAVE, JSON.stringify([{ id: 'mia:' + Date.now().toString(36), titolo, nota: String(scheda.nota || ''), esercizi }, ...resto].slice(0, 40)))) return false
  manda(); return true
}
export function togliMia (id) { scrivi(CHIAVE, JSON.stringify(mieSchede().filter(s => s.id !== id))); manda() }
// da dove partire: le mie schede, poi le pronte divise per programma. Ridà [{ gruppo, voci: [{ id, titolo, scheda }] }]
export function daDovePartire () {
  const mie = mieSchede().map(s => ({ id: s.id, titolo: s.titolo, scheda: s }))
  const pronte = SCHEDE_PRONTE.map(p => ({ gruppo: `${p.titolo} (${p.livello}, ${p.giorni} giorni)`, voci: SEDUTE_PRONTE.filter(s => s.programma === p.titolo).map(s => ({ id: s.id, titolo: s.titolo, scheda: { titolo: s.titolo, nota: '', esercizi: s.esercizi.map(e => ({ ...e, kg: null })) } })) }))
  return [...(mie.length ? [{ gruppo: 'Le mie schede', voci: mie }] : []), ...pronte]
}
export const trovaScheda = id => daDovePartire().flatMap(g => g.voci).find(v => v.id === id)?.scheda ?? null
