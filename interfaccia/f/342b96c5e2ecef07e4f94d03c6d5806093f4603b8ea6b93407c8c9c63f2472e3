// ---- Invita un cliente (Marco, 26-11-2026: «manca la parte dove si invitano con QR code o link e codice le persone») ----
// lo stesso invito della stanza Clienti sul computer: online un link personale (vale finché lo segui), se no quello sulla Wi-Fi.
// Il cliente inquadra il QR; se non può, gli mandi il link o gli detti il codice (Mirion Fit → Trainer → incolla).
function cartaInvito (d) {
  const box = el('div', { class: 't-invito' })
  const fai = async () => {
    bottone.disabled = true
    try {
      const r = await api('/api/clienti', { azione: d.online?.acceso ? 'invita-online' : 'invita' })
      const qr = el('div', { class: 't-qr' }); qr.innerHTML = r.qr ?? ''
      const link = r.url ?? r.link ?? '', codice = !r.online ? '' : (/[?&]k=([\w.~-]+)/.exec(link) || /\/([\w-]{12,})\/?(?:[?#]|$)/.exec(link) || [])[1] ?? ''
      // (28-11, Marco: «per accedere usiamo solo il codice; il link serve solo per trovare l'app»): il link senza il gettone
      const app = codice ? (() => { try { const x = new URL(link); return x.origin + x.pathname } catch { return link } })() : link
      const copia = async (t, detto) => { try { await navigator.clipboard.writeText(t); dimmi(detto) } catch { dimmi('Non riesco a copiare: tieni premuto sul testo.') } }
      metti(box, qr,
        el('p', { class: 't-nota', testo: r.online ? 'Il cliente apre Mirion Fit (dal QR o dal link) e scrive il codice: vale finché lo segui. Compare fra i tuoi clienti quando dà il consenso.' : `Col telefono sulla stessa Wi-Fi del computer. Vale una volta, fino a domani alle ${r.scade ? new Date(r.scade).toLocaleTimeString('it-IT', { hour: '2-digit', minute: '2-digit' }) : '—'}.` }),
        codice ? el('small', { class: 't-etichetta', testo: 'Il codice per entrare' }) : null, codice ? el('code', { class: 't-codice grande', testo: codice }) : null,
        el('small', { class: 't-etichetta', testo: codice ? 'Il link per trovare l’app' : 'Il link' }), el('code', { class: 't-codice', testo: app }),
        el('div', { class: 't-bottoni t-fila' },
          navigator.share ? el('button', { type: 'button', class: 't-primario', onclick: () => navigator.share({ title: 'Mirion Fit', text: codice ? `Apri Mirion Fit e scrivi il codice: ${codice}` : 'Il tuo link per Mirion Fit, con me come trainer:', url: app }).catch(() => {}) }, 'Manda il link') : null,
          el('button', { type: 'button', onclick: () => copia(app, 'Link copiato.') }, 'Copia il link'),
          codice ? el('button', { type: 'button', class: 't-primario', onclick: () => copia(codice, 'Codice copiato.') }, 'Copia il codice') : null,
          el('button', { type: 'button', onclick: () => { metti(box); box.append(bottone); bottone.disabled = false } }, 'Fatto')))
    } catch (e) { dimmi(e.message); bottone.disabled = false }
  }
  const bottone = el('button', { type: 'button', class: 't-primario t-largo', onclick: fai }, ico('piu'), 'Invita un cliente')
  box.append(bottone)
  return carta('Invita un cliente', 'con il codice', box)
}

