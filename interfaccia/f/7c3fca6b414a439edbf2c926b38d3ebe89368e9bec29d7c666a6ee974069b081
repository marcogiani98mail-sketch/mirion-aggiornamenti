// Impostazioni, a fasce: Delion sul computer (partire con il computer), le intelligenze artificiali che usi,
// e le chiavi (cartella del vault, Claude, calendario). Le chiavi segrete non tornano mai alla pagina: si vede solo se ci sono.
import { el, api, notifica, STATO } from './base.js'
import { guida } from './guida.js'
import { mie, obsidian } from './ia.js'
import { elencoWidget } from './widget.js'

const AIUTO = {
  DELION_VAULT: 'La cartella del tuo vault di Obsidian, per esempio C:\\Users\\tu\\Documents\\Cervello.',
  ANTHROPIC_API_KEY: 'Serve per la stanza «Claude» (la chat sul cervello, i consumi e il tetto di spesa) e per le notizie lette da Claude. La crei su console.anthropic.com e lì ricarichi il credito. «Fallo con…» invece usa le app e i siti con il tuo abbonamento: per quello la chiave non serve.',
  GOOGLE_ICAL: 'In Google Calendar: Impostazioni → il tuo calendario → «Indirizzo segreto in formato iCal». Così Mirion legge gli impegni, senza permessi da dare.',
  TELEGRAM_TOKEN: 'Su Telegram scrivi a @BotFather «/newbot», scegli un nome: ti dà il token. Poi scrivi «ciao» al tuo bot e premi «Trova la chat» qui sotto.',
  TELEGRAM_CHAT: 'Lo trova Mirion con «Trova la chat», dopo che hai scritto al tuo bot.',
  PONTE_ONLINE: 'L’indirizzo del ponte su Netlify: la Mirion sul telefono, ovunque, in sola lettura.',
  PONTE_CHIAVE: 'La chiave che il ponte riconosce: sul sito c’è solo la sua impronta.',
  MIRION_AGGIORNAMENTI: 'L’indirizzo del file degli aggiornamenti. Vuoto: quello di Mirion, su Netlify.',
}

export async function mostra (stanza) {
  const campi = await api('/api/impostazioni')
  stanza.replaceChildren(el('div', { class: 'fasce-scrivania' },
    el('section', { class: 'banner banner-basso' },
      el('div', { class: 'banner-saluto' }, el('h1', { testo: 'Impostazioni' }), el('p', { class: 'sopra', testo: `${STATO.note} note nel vault` })),
      el('div', { class: 'banner-adesso' }, el('h2', { testo: 'Il vault aperto adesso' }), el('p', { class: 'grande vault-percorso', testo: STATO.vault }),
        el('div', { class: 'bottoni' }, obsidian(''), el('button', { type: 'button', class: 'secondario', testo: 'Apri la guida all\'installazione', onclick: () => guida(true) }),
          el('button', { type: 'button', class: 'secondario', testo: 'Rileggi tutto il cervello', onclick: () => import('./primo-sguardo.js').then(m => m.primoSguardo(true)) })))),
    sulComputer(),
    iFile(),
    leIA(),
    aggiornamentiENotifiche(),
    ponteTelefono(),
    ilTelefono(),
    chiavi(campi, stanza)))
}

// i file del computer nel cervello (importa.js, 24-11)
function iFile () {
  return el('section', { class: 'fascia' }, el('header', {}, el('h2', { testo: 'I file del computer' })),
    el('p', { class: 'sopra', testo: 'Copia nel cervello i documenti che hai già (Documenti, Scrivania, Download…): gli originali restano dove sono. Poi Claude o Codex li leggono e scrivono le note.' }),
    el('div', { class: 'bottoni' }, el('a', { class: 'primario', href: '#importa', testo: 'Porta dentro i file del computer' })))
}

// partire con il computer: solo nell'app installata (nel browser non si può)
function sulComputer () {
  const app = window.delionApp, casella = el('input', { type: 'checkbox', id: 'avvio', disabled: !app })
  if (app) app.avvio().then(si => { casella.checked = si })
  casella.addEventListener('change', async () => { const si = await app.cambiaAvvio(casella.checked); casella.checked = si; notifica(si ? 'Mirion si aprirà quando accendi il computer, con la notifica delle cose di oggi.' : 'Mirion non parte più da solo.', { tipo: 'sempre' }) })
  return el('section', { class: 'fascia' }, el('header', {}, el('h2', { testo: 'Mirion sul computer' })),
    el('label', { class: 'interruttore', for: 'avvio' }, casella, el('span', { testo: 'Apri Mirion quando accendi il computer' })),
    el('p', { class: 'sopra piccolo', testo: app ? 'All\'accensione Mirion si apre e ti manda una notifica con le cose di oggi e le scadute.' : 'Questa scelta c\'è solo nell\'app installata: qui sei nel browser.' }))
}

// le IA che usi: vengono dagli accessi del preset; si aggiungono in Lavoro
function leIA () {
  return el('section', { class: 'fascia' }, el('header', {}, el('h2', { testo: 'Le intelligenze artificiali che usi' }), el('a', { class: 'sopra piccolo', href: '#lavoro', testo: 'aggiungine una in Lavoro → Personalizza' })),
    el('ul', { class: 'ia-elenco' }, ...mie().map((ia, i) => el('li', { style: { '--c1': ia.colori[0], '--c2': ia.colori[1] } }, el('img', { src: `/icone/${ia.id}.png`, alt: '' }), el('b', { testo: ia.nome }),
      el('small', { testo: i === 0 ? 'la prima: il pulsante grande di «Fallo con…»' : 'accanto alla prima' })))),
    el('p', { class: 'sopra piccolo', testo: 'Claude, ChatGPT, Perplexity, Copilot e Le Chat si aprono con la richiesta già scritta; Gemini con la richiesta negli appunti (Ctrl+V). L\'ordine è quello dei tuoi accessi.' }))
}

function chiavi (campi, stanza) {
  const gruppi = Object.groupBy ? Object.groupBy(campi, c => c.gruppo) : campi.reduce((o, c) => ((o[c.gruppo] ??= []).push(c), o), {})
  return el('form', { class: 'fascia impostazioni', onsubmit: async e => {
    e.preventDefault()
    const valori = Object.fromEntries([...new FormData(e.target)].filter(([, v]) => v !== ''))
    try { await api('/api/impostazioni', valori); notifica('Salvato.', { tipo: 'sempre' }); Object.assign(STATO, await api('/api/stato')); mostra(stanza) } catch (err) { notifica(err.message, { tipo: 'sempre' }) }
  } },
  el('header', {}, el('h2', { testo: 'Collegamenti e chiavi' })),
  el('div', { class: 'chiavi-fila' }, ...Object.entries(gruppi).map(([g, lista]) => el('fieldset', {}, el('legend', { testo: g }), ...lista.map(c => el('div', { class: 'campo' },
    el('label', { for: c.nome, testo: c.etichetta }),
    el('div', { class: 'riga-form' },
      el('input', { id: c.nome, name: c.nome, type: c.segreto ? 'password' : 'text', autocomplete: 'off', value: c.valore || null, placeholder: c.segreto ? (c.presente ? '•••••• c\'è già: scrivi solo per cambiarla' : 'non c\'è') : '' }),
      c.segreto && c.presente ? el('button', { type: 'button', class: 'quieto', testo: 'Togli', onclick: async () => { await api('/api/impostazioni/togli', { nome: c.nome }); mostra(stanza) } }) : null),
    AIUTO[c.nome] && el('small', { class: 'sopra', testo: AIUTO[c.nome] })))))),
  el('button', { class: 'primario', testo: 'Salva' }))
}

// gli aggiornamenti (server/aggiornamenti.mjs) e le notifiche su Telegram (server/telegram.mjs), Marco 22-11: «implementa tutto»
function aggiornamentiENotifiche () {
  const stato = el('p', { class: 'sopra', 'aria-live': 'polite', testo: 'Premi «Controlla» per sapere se c’è una Mirion più nuova.' })
  // l'avanzamento si vede nel riquadro in basso a destra, che resta anche se cambi pagina (aggiornamento.js)
  const aggiorna = el('button', { type: 'button', class: 'primario', hidden: true, testo: 'Aggiorna adesso', onclick: () => {
    stato.textContent = 'L’aggiornamento è partito: a che punto è lo vedi in basso a destra.'; import('./aggiornamento.js').then(m => m.aggiornaOra())
  } })
  const controlla = el('button', { type: 'button', class: 'secondario', testo: 'Controlla gli aggiornamenti', onclick: async () => {
    try {
      const r = await api('/api/aggiornamenti')
      stato.textContent = r.store ? `Questa Mirion (versione ${r.versione}) viene dal Microsoft Store: la aggiorna lo Store da solo.` : !r.attivo ? 'Manca l’indirizzo degli aggiornamenti (qui sotto, in «Aggiornamenti»).' : r.nuova ? `C’è la versione ${r.ultima} (questa è la ${r.versione}). ${r.note}` : `Mirion è aggiornata: versione ${r.versione}.`
      aggiorna.hidden = !r.nuova
    } catch (e) { stato.textContent = e.message }
  } })
  const tg = el('p', { class: 'sopra', 'aria-live': 'polite' })
  const fai = (via, ok) => async () => { try { const r = await api('/api/fuori/' + via, {}); tg.textContent = ok(r) } catch (e) { tg.textContent = e.message } }
  return el('section', { class: 'fascia' }, el('header', {}, el('h2', { testo: 'Aggiornamenti e notifiche' })),
    el('div', { class: 'bottoni' }, controlla, aggiorna), stato,
    el('h3', { testo: 'Le novità della squadra su Telegram' }),
    el('p', { class: 'sopra piccolo', testo: 'Quando un’altra persona della squadra manda il suo lavoro, oltre alla notifica sul computer ti arriva un messaggio su Telegram. Scrivi il token del bot qui sotto (in «Telegram») e salva, poi:' }),
    el('div', { class: 'bottoni' }, el('button', { type: 'button', class: 'secondario', testo: 'Trova la chat', onclick: fai('trova-chat', r => `Trovata la chat di ${r.nome || 'Telegram'}: salvata.`) }),
      el('button', { type: 'button', class: 'secondario', testo: 'Manda una prova', onclick: fai('prova', () => 'Mandata: guarda su Telegram.') })), tg)
}

// Mirion dal telefono (server/telefono.mjs; Marco, 23-11 sera: «una versione telefono… collegata al computer»): accendi la porta
// sulla rete di casa, abbina il telefono con un codice di 6 cifre, togli i telefoni che non usi più
function ilTelefono () {
  const box = el('div', {}, el('p', { class: 'sopra', testo: 'Leggo…' }))
  const fai = async (azione, extra = {}) => { try { disegna(await api('/api/telefono', { azione, ...extra })) } catch (e) { notifica(e.message, { tipo: 'sempre' }) } }
  const disegna = t => {
    const quando = ms => new Date(ms).toLocaleTimeString('it-IT', { hour: '2-digit', minute: '2-digit' })
    box.replaceChildren(...[ // .filter(Boolean): replaceChildren scriverebbe «null»
      el('p', { class: 'sopra', testo: t.acceso ? 'Acceso: dal telefono, sulla stessa rete Wi-Fi di questo computer, apri l’indirizzo qui sotto nel browser.' : 'Spento: dal telefono Mirion non si vede. Acceso, il telefono usa Mirion e i suoi software attraverso questo computer, sulla stessa rete Wi-Fi.' }),
      t.acceso ? el('div', { class: 'telefono-indirizzi' }, ...(t.indirizzi.length ? t.indirizzi.map(i => el('code', { class: 'telefono-indirizzo', testo: i })) : [el('p', { class: 'vuoto', testo: 'Questo computer non è su una rete di casa (Wi-Fi o cavo): collegalo e riprova.' })])) : null,
      t.codice?.codice ? el('div', { class: 'telefono-codice' }, el('small', { class: 'sopra', testo: `Il codice da scrivere sul telefono, vale fino alle ${quando(t.scade)}` }), el('b', { testo: t.codice.codice })) : null,
      el('div', { class: 'bottoni' },
        t.acceso
          ? [el('button', { type: 'button', class: 'primario', onclick: async () => { try { const r = await api('/api/telefono', { azione: 'codice' }); disegna({ ...r, codice: { codice: r.codice }, scade: r.scade }) } catch (e) { notifica(e.message, { tipo: 'sempre' }) } } }, 'Abbina un telefono'),
            el('button', { type: 'button', class: 'secondario', onclick: () => fai('spegni') }, 'Spegni')]
          : el('button', { type: 'button', class: 'primario', onclick: () => fai('accendi') }, 'Accendi')),
      t.dispositivi.length ? el('ul', { class: 'telefono-elenco' }, ...t.dispositivi.map(d => el('li', {}, el('b', { testo: d.nome }),
        el('small', { class: 'sopra', testo: `abbinato il ${new Date(d.quando).toLocaleDateString('it-IT')}${d.ultimo ? ' · usato il ' + new Date(d.ultimo).toLocaleDateString('it-IT') : ''} · ${Date.parse(d.scade) > Date.now() ? 'vale fino al ' + new Date(d.scade).toLocaleDateString('it-IT') : 'scaduto: abbinalo di nuovo'}` }),
        el('button', { type: 'button', class: 'quieto piccolo', onclick: () => fai('togli', { id: d.id }) }, 'Togli')))) : null,
      el('p', { class: 'sopra piccolo', testo: 'La prima volta Windows chiede se Mirion può usare la rete: scegli le reti private (casa). Il collegamento va solo sulla rete Wi-Fi in cui sei e non è cifrato: usalo a casa, non su un Wi-Fi condiviso (ufficio, palestra, albergo), dove chi è sulla stessa rete potrebbe leggere i dati. Per questo serve il codice, l’abbinamento dura 30 giorni, e quando non lo usi premi «Spegni».' })].filter(Boolean))
  }
  api('/api/telefono').then(disegna).catch(e => box.replaceChildren(el('p', { class: 'vuoto', testo: e.message })))
  return el('section', { class: 'fascia' }, el('header', {}, el('h2', { testo: 'Il telefono' })), box, el('h3', { class: 'sopra', testo: 'Le card sulla schermata Home' }), elencoWidget())
}

// il ponte (server/ponte.mjs, Marco 24-11: «l'app Mirion online… si installa da un QR code solo sul mio computer… si entra con le
// credenziali… in passiva»): nome utente e password, il QR (vale 10 minuti, una volta), l'ultima fotografia mandata, uscire ovunque
function ponteTelefono () {
  const corpo = el('div', { class: 'ponte-corpo' }, el('p', { class: 'sopra', testo: 'Leggo…' }))
  const sezione = el('section', { class: 'fascia ponte-telefono' }, el('header', {}, el('h2', { testo: 'Mirion sul telefono, ovunque' }), el('span', { class: 'sopra piccolo', testo: 'il ponte: vedi la scrivania e ricevi le notifiche, senza cambiare niente' })), corpo)
  const disegna = async () => {
    let s; try { s = await api('/api/ponte') } catch (e) { corpo.replaceChildren(el('p', { class: 'sopra', testo: e.message })); return }
    if (!s.acceso) { corpo.replaceChildren(el('p', { class: 'sopra', testo: 'Per accenderlo servono l’indirizzo e la chiave del ponte, qui sopra in «Mirion sul telefono».' })); return }
    const utente = el('input', { placeholder: 'nome utente', autocomplete: 'off', maxlength: 40 }), pw = el('input', { type: 'password', placeholder: 'password (almeno 10 caratteri)', autocomplete: 'new-password' })
    const qr = el('div', { class: 'ponte-qr' })
    corpo.replaceChildren(
      el('p', { class: 'sopra', testo: [s.online?.credenziali ? 'Nome utente e password impostati.' : 'Prima imposta nome utente e password.', s.online ? `Telefoni dentro: ${s.online.telefoni}, con le notifiche: ${s.online.notifiche}.` : null, s.quando ? `Ultima fotografia mandata alle ${new Date(s.quando).toLocaleTimeString('it-IT', { hour: '2-digit', minute: '2-digit' })}.` : null, s.errore ? '⚠ ' + s.errore : null].filter(Boolean).join(' ') }),
      el('form', { class: 'riga-form', onsubmit: async e => { e.preventDefault(); try { await api('/api/ponte', { azione: 'credenziali', utente: utente.value, password: pw.value }); notifica('Nome utente e password impostati. I telefoni di prima devono rientrare con il QR.', { tipo: 'sempre' }); disegna() } catch (err) { notifica(err.message, { tipo: 'sempre' }) } } },
        utente, pw, el('button', { class: 'secondario', testo: s.online?.credenziali ? 'Cambia' : 'Imposta' })),
      el('div', { class: 'bottoni' },
        el('button', { type: 'button', class: 'primario', disabled: !s.online?.credenziali, onclick: async () => {
          try { const r = await api('/api/ponte', { azione: 'invito' }); const t = document.createElement('template'); t.innerHTML = r.qr
            qr.replaceChildren(t.content.firstChild, el('p', { class: 'sopra piccolo', testo: `Inquadralo col telefono: vale fino alle ${new Date(r.scade).toLocaleTimeString('it-IT', { hour: '2-digit', minute: '2-digit' })}, una volta sola. Poi nome utente e password.` })) } catch (err) { notifica(err.message, { tipo: 'sempre' }) }
        } }, 'Mostra il QR'),
        el('button', { type: 'button', class: 'quieto', onclick: async () => { try { await api('/api/ponte', { azione: 'manda' }); notifica('Fotografia mandata.'); disegna() } catch (err) { notifica(err.message, { tipo: 'sempre' }) } } }, 'Manda adesso'),
        el('button', { type: 'button', class: 'quieto pericolo', onclick: async e => { if (e.target.dataset.sicuro !== '1') { e.target.dataset.sicuro = '1'; e.target.textContent = 'Sì, esci da tutti i telefoni'; return } try { await api('/api/ponte', { azione: 'esci-tutti' }); notifica('Fatto: tutti i telefoni sono usciti.'); disegna() } catch (err) { notifica(err.message, { tipo: 'sempre' }) } } }, 'Esci da tutti i telefoni')),
      qr)
  }
  disegna()
  return sezione
}
