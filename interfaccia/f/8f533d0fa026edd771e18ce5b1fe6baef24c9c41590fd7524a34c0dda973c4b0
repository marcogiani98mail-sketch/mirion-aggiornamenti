// La cornice comune di Mirion Fit e di Mirion Trainer sul telefono (Marco, 27-11-2026: «dai a Mirion Trainer le stesse funzioni
// di Mirion Fit, con il contenuto di adesso: tornare indietro, personalizzazione ecc., così non le ripetiamo ogni volta»).
// Un pezzo solo per le due web app: il tasto ‹ in alto (dove porta, pagina per pagina), i colori di Personalizza (le sfumature e
// i cursori) e l'ordine delle card (su, giù, nascondi). Ognuna ci mette la sua grafica e i suoi nomi.
// Si cambia QUI (mirion-codice, app/js/cornice.js) e si ricopia uguale in Mirion Fit (Programma/public/cornice.js): una prova di
// prova.mjs controlla che le due copie siano identiche. Niente import: la tabella dei colori la passa chi lo usa.

// ---- il tasto ‹ in alto ----
// regole: [espressione sull'indirizzo (#…), dove porta (testo, o funzione della corrispondenza)]; vale la prima che corrisponde.
// Nessuna regola = sei già in cima a una sezione, e il tasto non si vede.
export function tornaSu (hash, regole) {
  for (const [re, su] of regole) { const m = re.exec(hash || ''); if (m) return typeof su === 'function' ? su(m) : su }
  return null
}
// il tasto: si accende e si spegne a ogni cambio di pagina; «prima» chiude quello che è aperto sopra (un foglio, un menù)
export function montaIndietro (bottone, regole, { prima } = {}) {
  if (!bottone) return () => {}
  const aggiorna = () => { const su = tornaSu(location.hash, regole); bottone.hidden = !su; bottone.dataset.su = su || '' }
  bottone.addEventListener('click', e => { e.preventDefault(); prima?.(); location.hash = bottone.dataset.su || '#' })
  addEventListener('hashchange', aggiorna); aggiorna()
  return aggiorna
}

// ---- i colori di Personalizza: le sfumature pronte e i cursori dello spazio dei colori (come Mirion sul computer) ----
// i cursori, per tutte e due: [id, nome, minimo, massimo, unità]; ognuna mostra quelli che ha in «base»
export const CURSORI_COLORI = [['accento', 'Il colore', 0, 360, '°'], ['secondo', 'Il secondo colore', 0, 360, '°'], ['saturazione', 'Quanto è vivo', 0, 200, '%'],
  ['trasparenza', 'Card piene', 20, 100, '%'], ['buio', 'Fondo nero', 0, 100, '%']]
export function creaColori (SFUMATURE, base) {
  const sfumature = () => Object.entries(SFUMATURE).map(([id, [nome, accento, secondo]]) => ({ id, nome, accento, secondo }))
  const valida = s => (s && SFUMATURE[s.tema] ? s : null)
  // la scelta → i numeri dei cursori (quelli della sfumatura, se non li hai mossi)
  function cursori (s) {
    const [, accento, secondo, , buio] = SFUMATURE[s?.tema] || SFUMATURE.viola
    const c = s?.colori || {}, n = (v, b) => (v !== null && v !== '' && Number.isFinite(+v) ? +v : b)
    const fuori = { accento: n(c.accento, accento), secondo: n(c.secondo, secondo) }
    for (const [k, v] of Object.entries(base)) fuori[k] = n(c[k], k === 'buio' ? (buio ?? v) : v)
    return fuori
  }
  const quali = () => CURSORI_COLORI.filter(([id]) => id === 'accento' || id === 'secondo' || id in base)
  return { sfumature, valida, cursori, quali }
}
// il tondo di una sfumatura (lo stesso disegno nelle due app)
export const sfondoTondo = x => `linear-gradient(135deg, oklch(.64 .17 ${x.accento}), oklch(.72 .15 ${x.secondo}))`

// ---- l'ordine delle card: quelle scelte prima, le nuove in fondo; le nascoste restano nell'elenco, spente ----
export function ordineCard (tutte, scelta = {}) {
  const ordine = [...new Set([...(Array.isArray(scelta.ordine) ? scelta.ordine : []).filter(id => tutte.includes(id)), ...tutte])]
  return { ordine, nascoste: (Array.isArray(scelta.nascoste) ? scelta.nascoste : []).filter(id => tutte.includes(id)) }
}
export function sposta (ordine, id, verso) {
  const o = [...ordine], i = o.indexOf(id), j = i + verso
  if (i < 0 || j < 0 || j >= o.length) return o
  ;[o[i], o[j]] = [o[j], o[i]]
  return o
}
export const alterna = (nascoste, id) => (nascoste.includes(id) ? nascoste.filter(x => x !== id) : [...nascoste, id])
